<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Attachment export/import through the standard open/save panels. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Voice capture parity with iOS. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- macOS spells the APNs entitlement with the developer prefix. -->
	<key>com.apple.developer.aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- Required on the host app as well as the extension: App Store
	     validation rejects the bundle if either is missing it (error 90729). -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- Same vault group as iOS so shared one-time-code types keep working. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.lab86.mail</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:mail.lab86.io</string>
		<string>webcredentials:$(LAB86_INFO_CLERK_FRONTEND_API_HOST)</string>
	</array>
</dict>
</plist>
