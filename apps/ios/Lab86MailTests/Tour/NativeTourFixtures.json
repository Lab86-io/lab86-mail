  "threadDetails": {
    "t-venue": {
      "subject": "Offsite venue: final head count",
      "messages": [
        {
          "id": "m-venue-1",
          "from": "Sarah Chen <sarah.chen@northwind.example>",
          "to": "Casey Morgan <casey@northwind.example>",
          "date": "@ms:now-1d",
          "snippet": "Harbor Hall can hold the main room for us.",
          "textBody": "Hi Casey,\n\nHarbor Hall can hold the main room for us on the 12th and 13th. They need a final head count before they sign the contract.\n\nThe floor plan is attached. The main room seats 30 at round tables.\n\nSarah",
          "attachments": [
            { "attachmentId": "att-floor", "filename": "Harbor Hall floor plan.pdf", "mimeType": "application/pdf", "size": 482113 }
          ]
        },
        {
          "id": "m-venue-2",
          "from": "Casey Morgan <casey@northwind.example>",
          "to": "Sarah Chen <sarah.chen@northwind.example>",
          "date": "@ms:now-20h",
          "snippet": "Thanks. I am waiting on two teams.",
          "textBody": "Thanks, Sarah. I am waiting on two teams. I will send the number as soon as I have it.\n\nCasey"
        },
        {
          "id": "m-venue-3",
          "from": "Sarah Chen <sarah.chen@northwind.example>",
          "to": "Casey Morgan <casey@northwind.example>",
          "date": "@ms:now-12m",
          "snippet": "Can you confirm the head count by Friday?",
          "textBody": "Hi Casey,\n\nCan you confirm the head count by Friday? The venue needs the number before they hold the room. If we miss Friday, the next open date is in April.\n\nAlso, do we need the projector in the second room?\n\nThanks,\nSarah"
        }
      ]
    }
  },
