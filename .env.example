# lab86-mail — hosted (Railway + Convex) environment reference.
# Values live in Railway service variables; this file documents the surface.

# --- Core services -----------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=
LAB86_CONVEX_INTERNAL_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Svix signing secret of the Clerk webhook endpoint (/api/clerk/webhook).
# Without it every Clerk event fails verification, including user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=
# https://mail.lab86.io in production; http://localhost:3000 for local development.
LAB86_MAIL_PUBLIC_URL=
# Local production-build testing only; suppresses scheduled side effects and
# enables development feature defaults. Never set this on hosted production.
# LAB86_DEVELOPMENT_MODE=true
# Optional browser challenge for a deliberately shared development instance.
# LAB86_MAIL_REQUIRE_BASIC_AUTH=1
# LAB86_BASIC_AUTH_USER=
# LAB86_BASIC_AUTH_PASSWORD=

# --- Nylas -------------------------------------------------------------------
NYLAS_API_KEY=
NYLAS_CLIENT_ID=
NYLAS_CLIENT_SECRET=
# HMAC secret issued when the webhook destination is created in the Nylas
# dashboard. REQUIRED in production: without it /api/nylas/webhook rejects all
# deliveries (set LAB86_MAIL_ALLOW_UNVERIFIED_WEBHOOKS=1 only for local dev).
NYLAS_WEBHOOK_SECRET=
# LAB86_MAIL_ALLOW_UNVERIFIED_WEBHOOKS=1

# --- Providers ---------------------------------------------------------------
# iCloud rollout: hidden (default) | disabled | beta | enabled.
# beta/enabled shows the connect button; it stays disabled until the Nylas
# iCloud connector exists and LAB86_MAIL_NYLAS_ICLOUD_CONNECTOR_READY=1.
# LAB86_MAIL_ICLOUD_MODE=beta
# LAB86_MAIL_NYLAS_ICLOUD_CONNECTOR_READY=1

# --- Cloud files -------------------------------------------------------------
# Writable Files-surface OAuth. Google grants Drive browse plus app-created
# Docs, Sheets, and Slides editing; Microsoft grants OneDrive read/write.
# Register the shared callback
# https://<host>/api/files/oauth/callback with Google Cloud and Microsoft Entra.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Google Cross-Account Protection (docs/google-risc.md). 1 lets security
# events change connections; unset, they are verified and logged only.
# LAB86_GOOGLE_RISC=1
# The OAuth client ids that an event may name. Default: the mail and Drive client ids.
# LAB86_GOOGLE_RISC_AUDIENCES=
MICROSOFT_DRIVE_CLIENT_ID=
MICROSOFT_DRIVE_CLIENT_SECRET=
# Optional override; defaults to LAB86_MAIL_PUBLIC_URL + the callback path.
# CLOUD_FILES_REDIRECT_URI=

# --- Search tiers ------------------------------------------------------------
# Local (Convex corpus) search is the default for all providers once the
# corpus is backfilled. Override per provider when debugging:
# LAB86_MAIL_LOCAL_SEARCH_PROVIDERS=google,microsoft,icloud,imap
# LAB86_MAIL_LOCAL_SEARCH_DISABLED_PROVIDERS=
# LAB86_MAIL_LOCAL_SEARCH_GOOGLE=1

# --- AI ----------------------------------------------------------------------
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LAB86_MAIL_OPENAI_MODEL=gpt-5.5
# LAB86_MAIL_OPENAI_FAST_MODEL=gpt-5.4-mini
# Dedicated sparse Area-routing model. OpenRouter keeps the provider prefix;
# direct OpenAI routing strips it safely before constructing the model client.
# LAB86_MAIL_CLASSIFY_MODEL=openai/gpt-5.6-luna
# Typed-decision mail classifier (lib/classifier/catalog.ts). Operators on the
# Clerk admin plan switch it in Settings -> Classification; this is the default
# until they do. Together-hosted entries (tev1-4b) need TOGETHER_API_KEY.
# LAB86_MAIL_CLASSIFIER=jev-1.13
# TOGETHER_API_KEY=

# --- Albatross notifications ------------------------------------------------
# Generate once with `npx web-push generate-vapid-keys` and keep the private
# value server-only. Permission is still requested explicitly in Settings.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@lab86.io
# Transactional fallback email for unanswered evening check-ins.
RESEND_API_KEY=
LAB86_NOTIFICATION_FROM=Albatross <notifications@lab86.io>
# Dedicated HMAC secret for notification deep links. Generate a separate,
# random value; links fail closed when it is omitted.
LAB86_NOTIFICATION_LINK_SECRET=
# The loop alarm (lib/ai/cost-alarm.ts): one email to this address when a
# user's background model cost passes the threshold in 24 hours. No address,
# no alarm. It uses RESEND_API_KEY and LAB86_NOTIFICATION_FROM, and it never
# stops a user.
LAB86_OWNER_ALERT_EMAIL=
# LAB86_COST_ALARM_USD=5

# Native iOS push (Apple Push Notification service). APNS_PRIVATE_KEY may be
# the PEM contents with literal \n escapes when configured as one env value.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=io.lab86.mail
# Optional comma-separated additional Web Push service hostnames.
LAB86_PUSH_ENDPOINT_HOSTS=

# --- Billing -----------------------------------------------------------------
# CLERK_PRO_PLAN_SLUG=mail_pro
# CLERK_BYOK_PLAN_SLUG=mail_byok
# CLERK_ADMIN_PLAN_SLUG=admin
# Both URLs also accept NEXT_PUBLIC_-prefixed variants
# (NEXT_PUBLIC_CLERK_BILLING_CHECKOUT_URL / NEXT_PUBLIC_CLERK_BILLING_PORTAL_URL).
# CLERK_BILLING_CHECKOUT_URL=
# CLERK_BILLING_PORTAL_URL=

# Optional embedded Collabora editor. Use different signing secrets per environment.
# OFFICE_JWT_SECRET must contain at least 32 characters.
OFFICE_EDITOR_PROVIDER=collabora
OFFICE_EDITOR_ENABLED=false
OFFICE_DOCUMENT_SERVER_URL=
OFFICE_APP_ORIGIN=
OFFICE_JWT_SECRET=
# OFFICE_THEMED_CHROME=true
# Version 2 slide authoring (rich elements, deck themes, designed generation).
# Server flag and the client build flag; both default on in local development.
# DECK_V2_AUTHORING=true
# NEXT_PUBLIC_DECK_V2_AUTHORING=true
# Browserbase powers the shared browser, web tools, and the slide render check.
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
